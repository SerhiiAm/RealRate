# Copy this file to .env and fill in real values. Never commit .env.

# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Number of proxies in front of Django (0 locally, 1 behind one Nginx that
# sets X-Forwarded-For). Needed so the login limit counts real client IPs.
DJANGO_NUM_PROXIES=0

# PostgreSQL (shared by the db container and Django).
# HOST/PORT are for running Django on your machine; docker compose overrides them.
POSTGRES_DB=realrate
POSTGRES_USER=realrate
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
